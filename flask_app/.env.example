# Flask Configuration
SECRET_KEY="replace-with-a-random-secret-key"
FLASK_ENV="development"
FLASK_PORT=5000

# Database Configuration (SQLite default; can use postgresql://user:pass@host/dbname)
DATABASE_URL="sqlite:///finance_advisor.db"

# Gemini AI API Key
GEMINI_API_KEY="your-gemini-api-key-here"

# Ngrok Configuration (Optional for public deployment)
NGROK_AUTHTOKEN="your-ngrok-authtoken-optional"
